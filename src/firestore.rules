rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Donors Collection: Real-time public registration and admin management
    match /donors/{donorId} {
      allow read, write: if true;
    }

    // Public Tokens Collection: Public token verification & status tracking
    match /public_tokens/{tokenNumber} {
      allow read, write: if true;
    }

    // Settings Collection: Dynamic registration form fields configuration
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Admin Profiles Collection
    match /admins/{adminId} {
      allow read, write: if true;
    }
  }
}
